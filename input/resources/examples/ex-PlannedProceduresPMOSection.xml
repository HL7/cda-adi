          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.3.orderDetail">
            <content styleCode="Answer">Betsy wants comfort-focused care and not extensive medical
              treatments or interventions</content>
          </td>
          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.3.procedure"> </td>
          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.3.goal"/>
          <td align="left" colspan="1">
            <list ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.3.notes">
              <item ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.3.note1">
                <content styleCode="Italic">These orders are in addition to those above (e.g., blood
                  products, dialysis).</content>
              </item>
            </list>
          </td>
        </tr>
        <tr>
          <td align="left" colspan="5"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.3.instruction1">
            <content styleCode="Italic">EMS protocols may limit emergency responder ability to act
              on orders in this section.</content>
          </td>
        </tr>
      </tbody>
    </table>
