      <thead>
        <tr ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.orderType">
          <td align="left" colspan="5">
            <content styleCode="Bold">A. Cardiopulmonary Resuscitation Orders.</content>
          </td>
        </tr>
        <tr>
          <td colspan="1">Order Precondition</td>
          <td colspan="1">Order Detail</td>
          <td colspan="1">Procedure</td>
          <td colspan="1">Goal</td>
          <td colspan="1">Note(s)</td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.orderPrecondition"
            >Follow these orders if <content
              ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.precondition1"
              >patient has no pulse and/or is not breathing</content>.</td>
          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.orderDetail"> No CPR:
            Do Not Attempt Resuscitation. </td>
          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.procedure">
            <content styleCode="Bold"
              ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.procedurePerform">DO
              NOT Perform </content>
            <content
              ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.procedureProcedure"
              >Cardiopulmonary Resuscitation</content>
          </td>
          <td align="left" colspan="1"
            ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.goal"/>
          <td align="left" colspan="1">
            <list ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.notes">
              <item ID="e14539-1d5e9110a6a64c92976a69e4a60d7cda-1750106336.59772-4.1.note1">
                <content styleCode="Italic">May choose any option in Section B.</content>
              </item>
            </list>
          </td>
        </tr>
      </tbody>
    </table>
