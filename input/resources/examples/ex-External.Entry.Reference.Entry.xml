        <act classCode="ACT" moodCode="EVN">
            <templateId root="2.16.840.1.113883.4.823.1.4.2.5" extension="2026-08-28"/>
            <id extension="Coverage/wellpoint-star-mimi"/>
            <code code="Coverage"/><!-- Use the codes from FHIR Resource Type -->
            <text>
                <reference value="#coverage1"/>
            </text>
            <statusCode code="completed"/>
            <reference typeCode="REFR">
                <externalAct>
                    <id root="a7d4b920-58e2-4f47-9d72-3b0cf93482e1" extension="TXSTAR-MIMI-4827316"/>
                </externalAct>
            </reference>
        </act>
    </entry>
